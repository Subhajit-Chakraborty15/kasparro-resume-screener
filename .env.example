# Copy to .env and fill in. Never commit .env.
# Everything is optional: without keys the system runs in deterministic mode.

# ---- LLM (semantic project-quality judgement) ----
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                        # blank = provider default (anthropic: claude-sonnet-5-5, openai: gpt-4.1-mini)
LLM_TIMEOUT_SECONDS=60
LLM_CONCURRENCY=4
LLM_BLEND=0.5                     # weight of LLM score vs deterministic score for AI project depth (0..1)

# ---- GitHub enrichment ----
GITHUB_TOKEN=                     # optional, raises rate limit from 60/h to 5000/h
GITHUB_CONCURRENCY=4
GITHUB_TIMEOUT_SECONDS=15
GITHUB_CACHE_PATH=output/.github_cache.json
GITHUB_CACHE_TTL_HOURS=6

# ---- Pipeline ----
PARSE_CONCURRENCY=8
MAX_FILE_MB=15
WEAK_AI_THRESHOLD=12              # AI depth below this => total score is capped
WEAK_AI_TOTAL_CAP=50
